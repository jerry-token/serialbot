{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SerialBot",
  "mainBinaryName": "serialbot",
  "version": "0.2.0",
  "identifier": "cc.aiany.serialbot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SerialBot",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "Serial port assistant with AI (MCP)",
    "category": "DeveloperTool"
  }
}
